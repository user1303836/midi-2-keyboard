{
  "format": "midi-2-keyboard-profiles",
  "version": 1,
  "profiles": [
    {
      "id": "ex-stream-voice",
      "name": "Streaming: voice (always on)",
      "always_on": true,
      "mappings": [
        {
          "id": "ex-stream-ptt",
          "name": "Hold pad 1 to talk (holds F15)",
          "source": {
            "device": null,
            "channel": null,
            "event": { "type": "note", "notes": { "min": 36, "max": 36 }, "velocity": { "min": 1, "max": 127 } }
          },
          "behavior": { "type": "hold", "target": { "type": "keys", "keys": ["F15"] }, "auto_repeat": false }
        },
        {
          "id": "ex-stream-mute",
          "name": "Pad 2 toggles mute (Ctrl+Shift+M)",
          "source": {
            "device": null,
            "channel": null,
            "event": { "type": "note", "notes": { "min": 37, "max": 37 }, "velocity": { "min": 1, "max": 127 } }
          },
          "behavior": { "type": "trigger", "on_press": { "type": "keys", "keys": ["ControlLeft", "ShiftLeft", "KeyM"] } }
        },
        {
          "id": "ex-stream-latched-talk",
          "name": "Latching button (CC 85) keeps the mic open (holds F15)",
          "source": {
            "device": null,
            "channel": null,
            "event": { "type": "control_change", "controller": 85, "range": { "min": 64, "max": 127 } }
          },
          "behavior": { "type": "hold", "target": { "type": "keys", "keys": ["F15"] }, "auto_repeat": false }
        }
      ]
    },
    {
      "id": "ex-stream-obs",
      "name": "Streaming: OBS scenes",
      "apps": [{ "process": "obs*", "title": "" }],
      "mappings": [
        {
          "id": "ex-stream-scene1",
          "name": "Pad 5 switches to scene 1 (Ctrl+Shift+F1)",
          "source": {
            "device": null,
            "channel": null,
            "event": { "type": "note", "notes": { "min": 40, "max": 40 }, "velocity": { "min": 1, "max": 127 } }
          },
          "behavior": { "type": "trigger", "on_press": { "type": "keys", "keys": ["ControlLeft", "ShiftLeft", "F1"] } }
        },
        {
          "id": "ex-stream-scene2",
          "name": "Pad 6 switches to scene 2 (Ctrl+Shift+F2)",
          "source": {
            "device": null,
            "channel": null,
            "event": { "type": "note", "notes": { "min": 41, "max": 41 }, "velocity": { "min": 1, "max": 127 } }
          },
          "behavior": { "type": "trigger", "on_press": { "type": "keys", "keys": ["ControlLeft", "ShiftLeft", "F2"] } }
        },
        {
          "id": "ex-stream-scene3",
          "name": "Pad 7 switches to scene 3 (Ctrl+Shift+F3)",
          "source": {
            "device": null,
            "channel": null,
            "event": { "type": "note", "notes": { "min": 42, "max": 42 }, "velocity": { "min": 1, "max": 127 } }
          },
          "behavior": { "type": "trigger", "on_press": { "type": "keys", "keys": ["ControlLeft", "ShiftLeft", "F3"] } }
        },
        {
          "id": "ex-stream-record",
          "name": "Pad 8: tap = start / stop recording, hold = start / stop streaming",
          "source": {
            "device": null,
            "channel": null,
            "event": { "type": "note", "notes": { "min": 43, "max": 43 }, "velocity": { "min": 1, "max": 127 } }
          },
          "behavior": {
            "type": "tap_hold",
            "tap": { "type": "keys", "keys": ["ControlLeft", "ShiftLeft", "F9"] },
            "hold": { "type": "keys", "keys": ["ControlLeft", "ShiftLeft", "F10"] },
            "hold_ms": 800
          }
        }
      ]
    },
    {
      "id": "ex-stream-game",
      "name": "Streaming: in game",
      "apps": [{ "process": "", "title": "*Game*" }],
      "mappings": [
        {
          "id": "ex-stream-game-pad5",
          "name": "Pad 5 throws a grenade (G)",
          "source": {
            "device": null,
            "channel": null,
            "event": { "type": "note", "notes": { "min": 40, "max": 40 }, "velocity": { "min": 1, "max": 127 } }
          },
          "behavior": { "type": "trigger", "on_press": { "type": "keys", "keys": ["KeyG"] } }
        },
        {
          "id": "ex-stream-game-pad6",
          "name": "Pad 6 reloads (R)",
          "source": {
            "device": null,
            "channel": null,
            "event": { "type": "note", "notes": { "min": 41, "max": 41 }, "velocity": { "min": 1, "max": 127 } }
          },
          "behavior": { "type": "trigger", "on_press": { "type": "keys", "keys": ["KeyR"] } }
        }
      ]
    }
  ]
}
