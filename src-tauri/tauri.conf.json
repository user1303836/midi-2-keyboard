{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MIDI 2 Keyboard",
  "version": "0.1.0",
  "identifier": "dev.midi2keyboard.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MIDI 2 Keyboard",
        "width": 1240,
        "height": 800,
        "minWidth": 920,
        "minHeight": 600,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Translate MIDI events into keyboard and mouse input.",
    "category": "Utility",
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
